# Copy to .env and adjust. Never commit a real .env.

# --- Postgres ---
POSTGRES_USER=cloudriskiq
POSTGRES_PASSWORD=cloudriskiq
POSTGRES_DB=cloudriskiq

# --- Backend ---
# In Docker Compose the backend talks to the `db` service host.
DATABASE_URL=postgresql://cloudriskiq:cloudriskiq@db:5432/cloudriskiq
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
