# Copy to .env and adjust. Never commit a real .env.

# --- Postgres ---
POSTGRES_USER=cloudriskiq
POSTGRES_PASSWORD=cloudriskiq
POSTGRES_DB=cloudriskiq

# --- Backend ---
# Compose passes this in. The API reads it and does not connect.
# Findings stay in memory. Postgres is unused.
DATABASE_URL=postgresql://cloudriskiq:cloudriskiq@db:5432/cloudriskiq
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000

# --- Frontend ---
# Read when `npm run dev` starts, and when `npm run build` runs.
# A value set only on an already-built container does not change the bundle.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
